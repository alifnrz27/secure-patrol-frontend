# Rendered by the nginx image at start; ${PORT} and ${BACKEND_UPSTREAM} come from
# the container environment.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Backend on the same server. proxy_pass without a URI forwards the request
    # URI exactly as the browser sent it, so X-Signature (which signs the path +
    # query) and the body stay valid.
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Overwritten here, never taken from the client: set PROXY_HEADER=X-Real-IP
        # on the backend so audit logs show the user's IP, not the container's.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The backend accepts up to 20 MB (face photos); keep a little headroom.
        client_max_body_size 21m;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /health {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Hashed build files never change: cache them for a year.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # SPA fallback: every route is served by index.html, which is not cached so a
    # new deployment is picked up right away.
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }
}
