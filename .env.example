# Base URL of the Secure Patrol backend, without trailing slash. API paths start with /api/v1.
# - Local development (npm run dev): e.g. http://127.0.0.1:3010
# - Docker Compose: leave EMPTY; nginx proxies /api to the backend (BACKEND_UPSTREAM).
#   Only set it to call the backend directly, using the URL the users' browsers reach.
VITE_API_BASE_URL=
# App Client with platform "web" (backend: go run . create-app-client -name "Secure Patrol Web" -platform web)
VITE_APP_ID=
VITE_APP_KEY=

# Docker Compose only:
# WEB_PORT=9002                                        # host port of the web admin
# BACKEND_UPSTREAM=http://host.docker.internal:9001    # backend as seen from the container
