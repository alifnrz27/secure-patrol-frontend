# Base URL of the Secure Patrol backend, without trailing slash. API paths start with /api/v1.
# For Docker/production this is the URL the users' browsers reach (not localhost of the server).
VITE_API_BASE_URL=http://127.0.0.1:3010
# App Client with platform "web" (backend: go run . create-app-client -name "Secure Patrol Web" -platform web)
VITE_APP_ID=
VITE_APP_KEY=

# Docker Compose only: host port for the web admin (default 9002).
# WEB_PORT=9002
